{
  "name": "@embedos/workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:image:force": "npm --prefix ./packages/debian-bullseye-busybox-recipe run build:force",
    "dev": "vite",
    "build:vite:types": "tsx ./scripts/build-vite-types.ts",
    "build:vite": "vite build --config vite.vite.config.ts && npm run build:vite:types",
    "build:runtime": "tsx ./scripts/build-runtime.ts",
    "build:recipes": "tsc -p packages/debian-bullseye-busybox-recipe/tsconfig.build.json && tsc -p packages/debian-bullseye-busybox-image-recipe/tsconfig.build.json",
    "build:cdn": "tsx ./scripts/build-cdn.ts",
    "build:demo": "tsx ./scripts/build-demo.ts",
    "build:lib:types": "vue-tsc -p packages/vue/tsconfig.build.json --declaration --emitDeclarationOnly",
    "build:lib": "vite build --config vite.lib.config.ts && npm run build:lib:types",
    "build": "npm run build:vite && npm run build:runtime && npm run build:recipes && npm run build:demo && npm run build:lib",
    "check:release": "npm run typecheck && npm run lint && npm run test && npm run format:check && npm run build:vite && npm run build:runtime && npm run build:recipes && npm run build:lib && npm run knip && npm run pack:check",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "pack:check": "tsx ./scripts/check-release-packages.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check && npm run knip",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "vite": "^8.0.3"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@embedos/debian-bullseye-busybox-image-recipe": "workspace:*",
    "@embedos/debian-bullseye-busybox-recipe": "workspace:*",
    "@embedos/debian-bullseye-busybox-runtime": "workspace:*",
    "@embedos/vue": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@iconify-json/streamline-ultimate-color": "^1.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "knip": "^6.3.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "jiti": "^2.6.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "tsx": "^4.20.6",
    "unplugin-icons": "^23.0.1",
    "vitest": "^4.1.2",
    "vue": "^3.5.31",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.6"
  }
}
